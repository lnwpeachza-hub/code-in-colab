def adf_t(x, max_lags=None):
    x = np.asarray(x, dtype=np.float64)
    x = x[np.isfinite(x)]
    n = len(x)
    if n < 50:
        return np.nan
    dy = np.diff(x)
    ylag = x[:-1]
    n_dy = len(dy)
    if max_lags is None:
        max_lags = int(math.ceil(12 * (n / 100.0)**0.25))
    max_lags = min(max_lags, (n - 10) // 3)
    max_lags = max(1, max_lags)
    best_t = np.nan
    best_aic = np.inf
    for p in range(1, max_lags + 1):
        curr_n = n_dy - p
        target = dy[p:]
        X_cols = [np.ones(curr_n), ylag[p:]]
        for i in range(p):
            X_cols.append(dy[p - i - 1 : n_dy - i - 1])
        X = np.column_stack(X_cols)
        xtx = X.T @ X
        sign, _ = np.linalg.slogdet(xtx)
        if sign <= 0:
            continue
        try:
            inv_xtx = np.linalg.inv(xtx)
        except np.linalg.LinAlgError:
            continue
        beta = np.linalg.lstsq(X, target, rcond=None)[0]
        resid = target - X @ beta
        dof = curr_n - X.shape[1]
        if dof <= 0:
            continue
        s2 = (resid @ resid) / dof
        se_beta1 = math.sqrt(s2 * inv_xtx[1, 1]) if inv_xtx[1, 1] > 0 else np.nan
        t_stat = beta[1] / se_beta1 if (not np.isnan(se_beta1) and se_beta1 > 0) else np.nan
        rss = resid @ resid
        if rss < 1e-12:
            rss = 1e-12
        aic = curr_n * math.log(rss / curr_n) + 2 * X.shape[1]
        if aic < best_aic:
            best_aic = aic
            best_t = t_stat
    return float(best_t) if not np.isnan(best_t) else np.nan

def kpss_t(x):
    x = np.asarray(x, dtype=np.float64)
    x = x[np.isfinite(x)]
    n = len(x)
    if n < 50:
        return np.nan
    mean_val = np.mean(x)
    e = x - mean_val
    s = np.cumsum(e)
    l_band = int(4 * (n / 100.0)**0.25)
    sig2 = np.mean(e**2)
    gamma = np.zeros(l_band + 1)
    for j in range(1, l_band + 1):
        cov = np.mean(e[:-j] * e[j:])
        gamma[j] = cov
    long_run_var = sig2
    for j in range(1, l_band + 1):
        long_run_var += 2 * (1.0 - j / (l_band + 1.0)) * gamma[j]
    if long_run_var < 1e-12:
        return np.nan
    stat = np.sum(s**2) / (n**2 * long_run_var)
    return float(stat)

def psi(a, b, n_bins=10):
    a = np.asarray(a, float)
    b = np.asarray(b, float)
    a = a[np.isfinite(a)]
    b = b[np.isfinite(b)]
    if len(a) < 100 or len(b) < 100 or np.std(a) < 1e-12:
        return np.nan
    edges = np.unique(np.quantile(a, np.linspace(0, 1, n_bins + 1)))
    if len(edges) < 3:
        return np.nan
    pa, _ = np.histogram(a, bins=edges)
    pb, _ = np.histogram(b, bins=edges)
    pa = pa / pa.sum() + 1e-6
    pb = pb / pb.sum() + 1e-6
    return float(np.sum((pa - pb) * np.log(pa / pb)))

def effective_rank(M):
    M = np.asarray(M, float)
    if M.shape[0] < M.shape[1] + 10:
        return np.nan
    Mc = M - M.mean(0)
    sd = Mc.std(0)
    valid = sd >= 1e-12
    if not np.any(valid):
        return np.nan
    Mc = Mc[:, valid]
    sd = sd[valid]
    sv = np.linalg.svd(Mc / sd, compute_uv=False)
    p = sv / sv.sum()
    p = p[p > 1e-15]
    return float(np.exp(-np.sum(p * np.log(p))))

def spearman(a, b):
    ra = pd.Series(a).rank().values
    rb = pd.Series(b).rank().values
    if np.std(ra) < 1e-12 or np.std(rb) < 1e-12:
        return np.nan
    return float(np.corrcoef(ra, rb)[0, 1])

def causal_norm_scaled(x, lookback):
    w = min(3000, max(500, int(lookback * 2)))
    ser = pd.Series(np.asarray(x, float))
    med = ser.rolling(w, min_periods=50).median()
    mad = (ser - med).abs().rolling(w, min_periods=50).median() + 1e-9
    return ((ser - med) / mad).fillna(0.0).values

def causal_winsor(x, w=W_NORM, lo=1.0, hi=99.0):
    ser = pd.Series(np.asarray(x, float))
    ql = ser.rolling(w, min_periods=50).quantile(lo / 100).shift(1)
    qh = ser.rolling(w, min_periods=50).quantile(hi / 100).shift(1)
    return np.clip(ser, ql, qh).fillna(ser).values

def fit_r2(Xa, ya, Xb, yb, seed=42):
    g = HistGradientBoostingRegressor(max_iter=50, max_depth=2, learning_rate=0.01,
                                      l2_regularization=10.0, min_samples_leaf=100, random_state=seed)
    g.fit(Xa, ya)
    pred = g.predict(Xb)
    return 1.0 - np.sum((yb - pred) ** 2) / (np.sum((yb - yb.mean()) ** 2) + 1e-12), g

def get_swap_rates(si):
    if si is None:
        return 0.0, 0.0
    if isinstance(si, dict):
        return float(si.get("swap_long", 0.0)), float(si.get("swap_short", 0.0))
    return float(getattr(si, "swap_long", 0.0)), float(getattr(si, "swap_short", 0.0))

def get_ic_markets_cost(symbol, df, info_dict):
    price = float(df["Close"].mean())
    si = info_dict.get(symbol)
    point_val = getattr(si, "point", 0.00001)
    contract_size = getattr(si, "trade_contract_size", 100000.0)
    spread_cols = [c for c in df.columns if c.lower() == "spread"]
    if len(spread_cols) > 0:
        spread_pts = float(df[spread_cols[0]].median())
        if spread_pts <= 0.0 or np.isnan(spread_pts):
            spread_pts = getattr(si, "spread", 2.0)
    else:
        spread_pts = getattr(si, "spread", 2.0)
    spread_cost = (spread_pts * point_val) / price
    comm_cost = 7.0 / (contract_size * price) if contract_size > 0 else 0.0
    return float(spread_cost + comm_cost)

def forward_rolling_sum(arr, w):
    ser = pd.Series(arr[::-1])
    res = ser.rolling(w).sum().values[::-1]
    return res

def forward_rolling_min(arr, w):
    ser = pd.Series(arr[::-1])
    res = ser.rolling(w).min().values[::-1]
    return res

def compute_forward_targets(logo, hh):
    n = len(logo)
    fwd_ret = np.full(n, np.nan)
    fwd_v = np.full(n, np.nan)
    fwd_sh = np.full(n, np.nan)
    fwd_down = np.full(n, np.nan)
    if n <= hh + 1:
        return fwd_ret, fwd_v, fwd_sh, fwd_down
    fwd_ret[:-(hh + 1)] = logo[hh + 1:] - logo[1:n - hh]
    diffs = np.diff(logo)
    sq_diffs = diffs ** 2
    fwd_sq_sum = forward_rolling_sum(sq_diffs, hh)
    fwd_v[:-(hh + 1)] = np.sqrt(fwd_sq_sum[1 : n - hh])
    extended_cusum = np.zeros(n)
    extended_cusum[1:] = np.cumsum(diffs)
    fwd_roll_min = forward_rolling_min(extended_cusum, hh)
    fwd_down[:-(hh + 1)] = fwd_roll_min[2 : n - hh + 1] - extended_cusum[1 : n - hh]
    return fwd_ret, fwd_v, fwd_sh, fwd_down

