def parse_currency_pair(symbol):
    clean = symbol.upper().replace("/", "").replace("_", "").replace("-", "")
    known_currencies = ["USD", "EUR", "GBP", "JPY", "AUD", "CAD", "CHF", "NZD"]
    for c1 in known_currencies:
        if clean.startswith(c1):
            c2 = clean[len(c1):]
            if c2 in known_currencies:
                return c1, c2
    return None, None

def calculate_autocorrelation(x, lag):
    x = np.asarray(x, dtype=np.float64)
    x = x[np.isfinite(x)]
    if len(x) < lag + 10:
        return np.nan
    mean_val = np.mean(x)
    var_val = np.var(x) + 1e-12
    covariance = np.mean((x[:-lag] - mean_val) * (x[lag:] - mean_val))
    return float(covariance / var_val)

def bootstrap_r2_ci(y_true, y_pred, n_bootstraps=100, seed=42):
    y_true = np.asarray(y_true, dtype=np.float64)
    y_pred = np.asarray(y_pred, dtype=np.float64)
    n = len(y_true)
    if n < 10:
        return np.nan, np.nan
    rng = np.random.default_rng(seed)
    r2_list = []
    for _ in range(n_bootstraps):
        idx = rng.choice(n, size=n, replace=True)
        yt = y_true[idx]
        yp = y_pred[idx]
        var_y = np.sum((yt - yt.mean())**2)
        if var_y < 1e-12:
            r2_list.append(1.0)
        else:
            res = np.sum((yt - yp)**2)
            r2_list.append(1.0 - res / var_y)
    return float(np.quantile(r2_list, 0.025)), float(np.quantile(r2_list, 0.975))

def get_ffd_weights(d, thres=1e-4, max_len=None):
    w = [1.0]
    k = 1
    while True:
        w_k = -w[-1] / k * (d - k + 1)
        if abs(w_k) < thres:
            break
        if max_len is not None and len(w) >= max_len:
            break
        w.append(w_k)
        k += 1
    return np.array(w, dtype=np.float64)

def ffd_series_fast(x, d, max_len=None, thres=1e-4):
    w = get_ffd_weights(d, thres, max_len)
    width = len(w)
    x = np.asarray(x, dtype=np.float64)
    n = len(x)
    if n < width:
        return np.zeros_like(x)
    w_rev = w[::-1]
    views = sliding_window_view(x, width)
    res = np.dot(views, w_rev)
    out = np.zeros_like(x)
    out[width - 1:] = res
    return out

def get_opt_ffd(x, w_norm, i_tr, max_len=None, threshold=-2.86):
    x_tr = x[w_norm : w_norm + i_tr]
    for d in np.linspace(0.1, 1.0, 10):
        w = get_ffd_weights(d, 1e-4, max_len)
        width = len(w)
        if len(x_tr) <= width + 50:
            continue
        ffd_tr = ffd_series_fast(x_tr, d, max_len=max_len)
        valid_ffd_tr = ffd_tr[width:]
        score = adf_t(valid_ffd_tr)
        if (not np.isnan(score)) and score < threshold:
            return d
    return 1.0

def causal_zscore(series, window, min_periods=50):
    ser = pd.Series(series)
    mean = ser.rolling(window, min_periods=min_periods).mean()
    std = ser.rolling(window, min_periods=min_periods).std() + 1e-9
    return ((ser - mean) / std).fillna(0.0).values

def calculate_yang_zhang_vol(o, h, l, c, window=96):
    log_o_cprev = np.log(o / (c.shift(1) + 1e-12)).fillna(0.0)
    log_c_o = np.log(c / (o + 1e-12)).fillna(0.0)
    log_h_c = np.log(h / (c + 1e-12)).fillna(0.0)
    log_h_o = np.log(h / (o + 1e-12)).fillna(0.0)
    log_l_c = np.log(l / (c + 1e-12)).fillna(0.0)
    log_l_o = np.log(l / (o + 1e-12)).fillna(0.0)
    rs = log_h_c * log_h_o + log_l_c * log_l_o
    v_o = log_o_cprev.rolling(window, min_periods=20).var(ddof=1).fillna(0.0).values
    v_c = log_c_o.rolling(window, min_periods=20).var(ddof=1).fillna(0.0).values
    v_rs = rs.rolling(window, min_periods=20).mean().fillna(0.0).values
    k = 0.34 / (1.34 + (window + 1) / (window - 1))
    sigma2 = v_o + k * v_c + (1.0 - k) * v_rs
    sigma2 = np.maximum(sigma2, 0.0)
    return np.sqrt(sigma2)

def get_directional_signal_series(symbol, prices, carry_signal=None):
    n = len(prices)
    pos = np.zeros(n)
    lookback = 2688 if symbol == "BTCUSD" else 11520
    log_p = np.log(prices)
    for t in range(n):
        if t >= lookback:
            sig = log_p[t] - log_p[t - lookback]
            trend_sign = 1.0 if sig >= 0.0 else -1.0
        elif t > 0:
            sig = log_p[t] - log_p[0]
            trend_sign = 1.0 if sig >= 0.0 else -1.0
        else:
            trend_sign = 1.0
        if symbol == "USDJPY":
            if carry_signal is not None:
                csig = carry_signal[t]
                carry_sign = 1.0 if csig >= 0.0 else -1.0
            else:
                carry_sign = 1.0
            if trend_sign == carry_sign:
                pos[t] = trend_sign
            else:
                pos[t] = 0.5 * trend_sign
        else:
            pos[t] = trend_sign
    return pos

def calculate_rule_returns(symbol, prices, horiz, cost, swap_rate, carry_signal=None):
    n = len(prices)
    pos = get_directional_signal_series(symbol, prices, carry_signal)
    rets = np.diff(np.log(prices))
    rule_rets = np.zeros(n)
    for t in range(1, n):
        p_prev = pos[t - 1]
        p_curr = pos[t]
        r_t = rets[t - 1]
        c_t = abs(p_curr - p_prev) * cost
        sw_t = 0.0
        if p_prev != 0.0 and (t % 96 == 0):
            sw_t = swap_rate * abs(p_prev)
        rule_rets[t] = p_prev * r_t - c_t - sw_t
    return rule_rets, pos

def block_bootstrap_spa(returns_matrix, block_size=288, n_bootstraps=200, seed=42):
    n, m = returns_matrix.shape
    if n < block_size * 2:
        return np.zeros(m), 1.0, [1.0] * m
    rng = np.random.default_rng(seed)
    means = np.mean(returns_matrix, axis=0)
    stds = np.std(returns_matrix, axis=0) + 1e-12
    t_stat_raw = np.max(np.maximum(means / stds, 0.0))
    boot_t_stats = []
    for _ in range(n_bootstraps):
        idx = []
        while len(idx) < n:
            start = rng.integers(0, n - block_size)
            idx.extend(range(start, start + block_size))
        idx = idx[:n]
        boot_samples = returns_matrix[idx, :]
        boot_means = np.mean(boot_samples, axis=0)
        centered = boot_means - means + np.minimum(means, 0.0)
        boot_stds = np.std(boot_samples, axis=0) + 1e-12
        t_stat_boot = np.max(np.maximum(centered / boot_stds, 0.0))
        boot_t_stats.append(t_stat_boot)
    p_val = np.mean(np.array(boot_t_stats) >= t_stat_raw)
    individual_p_vals = []
    for j in range(m):
        t_stat_j = max(means[j] / stds[j], 0.0)
        boot_t_j = []
        for _ in range(n_bootstraps):
            start_idx = rng.integers(0, n - block_size, size=n // block_size)
            idx_j = []
            for start in start_idx:
                idx_j.extend(range(start, start + block_size))
            idx_j = idx_j[:n]
            b_sample = returns_matrix[idx_j, j]
            b_mean = np.mean(b_sample)
            b_std = np.std(b_sample) + 1e-12
            cent = b_mean - means[j] + min(means[j], 0.0)
            boot_t_j.append(max(cent / b_std, 0.0))
        individual_p_vals.append(float(np.mean(np.array(boot_t_j) >= t_stat_j)))
    return means, float(p_val), individual_p_vals

def run_feature_ablation(df_feat, targets_dict, i_split, target_key, base_cols, seed=42):
    y_target = targets_dict[target_key][:i_split]
    m_valid = np.isfinite(y_target)
    if np.sum(m_valid) < 150:
         return {}
    y_clean = y_target[m_valid]
    X_clean = df_feat[base_cols].values[:i_split][m_valid]
    split_pt = int(len(X_clean) * 0.8)
    Xtr, ytr = X_clean[:split_pt], y_clean[:split_pt]
    Xte, yte = X_clean[split_pt:], y_clean[split_pt:]
    base_r2, _ = fit_r2(Xtr, ytr, Xte, yte, seed=seed)
    families = [
        "cumret", "vol_level", "breakout", "kc_dist", "har_rv",
        "rs_neg", "signed_jump", "yz_vol", "overnight_vol",
        "intraday_mom", "cross_rv"
    ]
    ablation_results = {}
    for fam in families:
         active_cols = [c for c in base_cols if fam not in c]
         if len(active_cols) == 0 or len(active_cols) == len(base_cols):
              continue
         col_indices = [base_cols.index(c) for c in active_cols]
         Xtr_ab, Xte_ab = Xtr[:, col_indices], Xte[:, col_indices]
         ab_r2, _ = fit_r2(Xtr_ab, ytr, Xte_ab, yte, seed=seed)
         delta_r2 = base_r2 - ab_r2
         ablation_results[fam] = delta_r2
    return ablation_results

def audit_pnl_reconciliation(equity_series, realized, unrealized, swaps, fees):
    n = len(equity_series)
    residuals = np.zeros(n)
    for t in range(1, n):
         eq_change = equity_series[t] - equity_series[0]
         calc_pnl = realized[t] + unrealized[t] + swaps[t] - fees[t]
         residuals[t] = eq_change - calc_pnl
    max_res = float(np.max(np.abs(residuals)))
    mean_res = float(np.mean(residuals))
    return max_res, mean_res

def verify_actual_ledger_for_rules(prices, pos, cost, swap_rate, contract_size):
    n = len(prices)
    balance = np.zeros(n)
    equity = np.zeros(n)
    unrealized = np.zeros(n)
    realized = np.zeros(n)
    fees = np.zeros(n)
    swaps = np.zeros(n)
    balance[0] = 10000.0
    equity[0] = 10000.0
    active_deal_price = 0.0
    active_deal_pos = 0.0
    for t in range(1, n):
        p_prev = pos[t - 1]
        p_curr = pos[t]
        s_curr = prices[t]
        deal_realized = 0.0
        deal_swap = 0.0
        deal_fee = 0.0
        if p_prev != 0.0:
            if (t % 96 == 0):
                deal_swap = -swap_rate * abs(p_prev) * contract_size * s_curr
        if p_prev != p_curr:
            deal_fee = cost * abs(p_curr - p_prev) * contract_size * s_curr
            if p_prev != 0.0:
                deal_realized = p_prev * (s_curr - active_deal_price) * contract_size
                active_deal_pos = 0.0
                active_deal_price = 0.0
            if p_curr != 0.0:
                active_deal_pos = p_curr
                active_deal_price = s_curr
        realized[t] = realized[t - 1] + deal_realized
        swaps[t] = swaps[t - 1] + deal_swap
        fees[t] = fees[t - 1] + deal_fee
        balance[t] = balance[t - 1] + deal_realized + deal_swap - deal_fee
        if active_deal_pos != 0.0:
            unrealized[t] = active_deal_pos * (s_curr - active_deal_price) * contract_size
        else:
            unrealized[t] = 0.0
        equity[t] = balance[t] + unrealized[t]
    max_res, mean_res = audit_pnl_reconciliation(equity, realized, unrealized, swaps, fees)
    return max_res, mean_res

