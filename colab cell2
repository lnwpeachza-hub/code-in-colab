class EmaVarianceTracker:
    def __init__(self, alpha=0.01, initial_var=1.0, floor=1e-3):
        self.alpha = alpha
        self.mean = 0.0
        self.var = initial_var
        self.floor = floor

    def update(self, val):
        self.mean = (1.0 - self.alpha) * self.mean + self.alpha * val
        diff = val - self.mean
        self.var = (1.0 - self.alpha) * self.var + self.alpha * (diff ** 2)
        return math.sqrt(max(self.var, self.floor))

