def action_saturation_diagnostic(env, model, seed, threshold=0.95, max_steps=3000):
    obs, _ = env.reset(seed=seed)
    actions = []
    n, done = 0, False
    while not done and n < max_steps:
        a, _ = model.predict(obs, deterministic=True)
        actions.append(np.asarray(a, dtype=float))
        obs, r, term, trunc, info = env.step(a)
        done = term or trunc
        n += 1
    actions = np.array(actions)
    print("ACTION MAGNITUDE SATURATION DIAGNOSTIC:")
    rows = []
    for i, s in enumerate(env.unwrapped.trading_symbols):
        mags = np.abs(actions[:, i])
        sat_frac = float(np.mean(mags > threshold))
        mean_mag = float(np.mean(mags))
        std_mag = float(np.std(mags))
        if sat_frac > 0.8:
            verdict = "FULLY SATURATED"
        elif sat_frac > 0.5:
            verdict = "HIGH MAGNITUDE"
        else:
            verdict = "OK"
        rows.append([s, f"{sat_frac:5.1%}", f"{mean_mag:.3f}", f"{std_mag:.3f}", verdict])
    print_table(["Symbol", "Saturation Frac", "Mean Mag", "Std Mag", "Verdict"], rows)
    return actions

def corrected_welch_ttest(a, b, o_factor):
    if len(a) < 3 or len(b) < 3:
        return float('nan'), float('nan'), float('nan')
    n_a = len(a)
    n_b = len(b)
    n_a_eff = max(3.0, n_a / o_factor)
    n_b_eff = max(3.0, n_b / o_factor)
    mean_a, mean_b = np.mean(a), np.mean(b)
    var_a = np.var(a, ddof=1) if len(a) > 1 else 0.0
    var_b = np.var(b, ddof=1) if len(b) > 1 else 0.0
    se = math.sqrt((var_a / n_a_eff) + (var_b / n_b_eff) + 1e-12)
    t_stat = (mean_a - mean_b) / se
    denom = ((var_a / n_a_eff)**2 / (n_a_eff - 1)) + ((var_b / n_b_eff)**2 / (n_b_eff - 1)) + 1e-12
    df = (se**2)**2 / denom
    df = max(3.0, df)
    log_p = stats.t.logsf(abs(t_stat), df=df) + math.log(2.0)
    neg_log10_p = -log_p / math.log(10.0)
    z_score = float(stats.norm.isf(np.exp(log_p))) if log_p > -50.0 else 10.0
    if t_stat < 0:
        z_score = -z_score
    return t_stat, neg_log10_p, z_score

def compute_required_seeds(agent_pnls, null_pnls, alpha=0.05, power=0.80):
    mean_a = np.mean(agent_pnls)
    mean_b = np.mean(null_pnls)
    var_a = np.var(agent_pnls, ddof=1) if len(agent_pnls) > 1 else 1e-9
    var_b = np.var(null_pnls, ddof=1) if len(null_pnls) > 1 else 1e-9
    pooled_std = math.sqrt((var_a + var_b) / 2.0)
    diff = abs(mean_a - mean_b)
    if pooled_std < 1e-9 or diff < 1e-9:
        return float('inf'), 0.0
    cohen_d = diff / pooled_std
    z_alpha = 1.96
    z_beta = 0.84
    n_req = 2.0 * ((z_alpha + z_beta) / cohen_d) ** 2
    return math.ceil(n_req), cohen_d

