class OnlineFeatureNormalizer:
    def __init__(self, shape, alpha=0.01):
        self.alpha = alpha
        self.mean = np.zeros(shape, dtype=np.float32)
        self.var = np.ones(shape, dtype=np.float32)

    def update(self, x):
        self.mean = (1.0 - self.alpha) * self.mean + self.alpha * x
        self.var = (1.0 - self.alpha) * self.var + self.alpha * ((x - self.mean) ** 2)
        std = np.sqrt(self.var)
        std[std < 1e-8] = 1.0
        return (x - self.mean) / std

class GradNormTracker:
    def __init__(self, module):
        self.norms = []
        self.hooks = []
        for p in module.parameters():
            if p.requires_grad:
                self.hooks.append(p.register_hook(self._make_hook()))

    def _make_hook(self):
        def hook(grad):
            self.norms.append(grad.detach().cpu().norm().item())
            return grad
        return hook

    def pop_mean(self):
        if not self.norms:
            return 0.0
        m = float(np.mean(self.norms))
        self.norms.clear()
        return m

    def close(self):
        for h in self.hooks:
            h.remove()

def compute_srank(X, eps=1e-12):
    if X.ndim != 2 or X.shape[0] < 2:
        return 1.0
    try:
        _, s, _ = np.linalg.svd(X, full_matrices=False)
    except np.linalg.LinAlgError:
        return 1.0
    s_sum = np.sum(s)
    if s_sum < eps:
        return 1.0
    p = s / s_sum
    p = np.clip(p, eps, 1.0)
    entropy = -np.sum(p * np.log(p))
    return float(np.exp(entropy))

def to_float_tensor(v, device):
    t = torch.as_tensor(v, device=device)
    if t.dtype == torch.float64:
        return t.to(torch.float32)
    return t

def compute_rollout_srank(model):
    policy = model.policy
    obs = model.rollout_buffer.observations
    tensor_obs = {}
    for k, v in obs.items():
        shape = v.shape
        flat_shape = (shape[0] * shape[1],) + shape[2:]
        tensor_obs[k] = to_float_tensor(v, policy.device).reshape(flat_shape)
    with torch.no_grad():
        features = policy.features_extractor(tensor_obs)
        latent_vf = policy.mlp_extractor.value_net(features)
    latent_vf_np = latent_vf.cpu().numpy()
    return compute_srank(latent_vf_np)

def compute_dual_zero_dormant(policy, obs_batch):
    policy.eval()
    dormant_ratio = 0.0
    try:
        obs_tensor = {}
        for k, v in obs_batch.items():
            obs_tensor[k] = to_float_tensor(v, policy.device)
        features = policy.features_extractor(obs_tensor)
        x = features
        total_neurons = 0
        dormant_neurons = 0
        for layer in policy.mlp_extractor.policy_net:
            if isinstance(layer, nn.Linear):
                x = layer(x)
                x.retain_grad()
                act_abs = torch.abs(x).mean(dim=0)
                dummy_loss = x.sum()
                dummy_loss.backward(retain_graph=True)
                grad_abs = torch.abs(x.grad).mean(dim=0) if x.grad is not None else torch.zeros_like(act_abs)
                is_dormant = (act_abs < 0.01) & (grad_abs < 1e-6)
                dormant_neurons += is_dormant.sum().item()
                total_neurons += x.shape[1]
            elif isinstance(layer, (nn.Tanh, nn.ReLU, nn.GELU)):
                x = layer(x)
        if total_neurons > 0:
            dormant_ratio = dormant_neurons / total_neurons
    except Exception:
        pass
    policy.train()
    return dormant_ratio

def compute_pcgrad_cosine(model, obs, actions, raw_rewards, penalties):
    policy = model.policy
    policy.zero_grad()
    tensor_obs = {}
    for k, v in obs.items():
        shape = v.shape
        flat_shape = (shape[0] * shape[1],) + shape[2:]
        tensor_obs[k] = to_float_tensor(v, policy.device).reshape(flat_shape)
    flat_actions_shape = (actions.shape[0] * actions.shape[1],) + actions.shape[2:]
    actions_tensor = torch.as_tensor(actions, device=policy.device).reshape(flat_actions_shape)
    if actions_tensor.dtype == torch.float64:
        actions_tensor = actions_tensor.to(torch.float32)
    raw_rewards_tensor = torch.as_tensor(raw_rewards, dtype=torch.float32, device=policy.device)
    penalties_tensor = torch.as_tensor(penalties, dtype=torch.float32, device=policy.device)
    distribution = policy.get_distribution(tensor_obs)
    log_prob = distribution.log_prob(actions_tensor)
    loss_raw = - (log_prob * raw_rewards_tensor).mean()
    loss_pen = - (log_prob * penalties_tensor).mean()
    policy_params = list(policy.action_net.parameters()) + list(policy.mlp_extractor.policy_net.parameters())
    policy_params = [p for p in policy_params if p.requires_grad]
    grad_raw = torch.autograd.grad(loss_raw, policy_params, retain_graph=True, allow_unused=True)
    grad_pen = torch.autograd.grad(loss_pen, policy_params, allow_unused=True)
    flat_grad_raw = []
    flat_grad_pen = []
    for gr, gp in zip(grad_raw, grad_pen):
        if gr is not None:
            flat_grad_raw.append(gr.detach().flatten())
        if gp is not None:
            flat_grad_pen.append(gp.detach().flatten())
    if not flat_grad_raw or not flat_grad_pen:
        return 0.0
    g_raw = torch.cat(flat_grad_raw)
    g_pen = torch.cat(flat_grad_pen)
    norm_raw = g_raw.norm()
    norm_pen = g_pen.norm()
    if norm_raw < 1e-8 or norm_pen < 1e-8:
        return 0.0
    cos_sim = torch.dot(g_raw, g_pen) / (norm_raw * norm_pen)
    return float(cos_sim.cpu().item())

def compute_shift_error_correlation(env, model, seed):
    obs, _ = env.reset(seed=seed)
    feature_values = []
    critic_preds = []
    done = False
    policy = model.policy
    while not done:
        with torch.no_grad():
            tensor_obs = {}
            for k, v in obs.items():
                t = torch.as_tensor(v, device=policy.device)
                if t.dtype == torch.float64:
                    t = t.to(torch.float32)
                tensor_obs[k] = t.unsqueeze(0)
            val = policy.predict_values(tensor_obs).cpu().numpy().item()
        feature_values.append(obs["features"][-1].copy())
        obs, r, term, trunc, info = env.step(model.predict(obs, deterministic=True)[0])
        critic_preds.append(val)
        done = term or trunc
    feature_values = np.array(feature_values)
    critic_preds = np.array(critic_preds)
    corrs = []
    for idx in range(feature_values.shape[1]):
        col = feature_values[:, idx]
        if np.std(col) > 1e-8 and np.std(critic_preds) > 1e-8:
            c, _ = stats.pearsonr(col, critic_preds)
            corrs.append(float(np.nan_to_num(c)))
        else:
            corrs.append(0.0)
    return corrs

def paired_bootstrap_analysis(agent_pnls, null_pnls, num_bootstrap=1000, seed=42):
    rng = np.random.default_rng(seed)
    diffs = np.array(agent_pnls) - np.array(null_pnls)
    if len(diffs) == 0:
        return 0.5, 0.0, 0.0
    boot_means = []
    for _ in range(num_bootstrap):
        boot_sample = rng.choice(diffs, size=len(diffs), replace=True)
        boot_means.append(np.mean(boot_sample))
    prob_outperform = float(np.mean(np.array(boot_means) > 0.0))
    mean_diff = float(np.mean(diffs))
    std_diff = float(np.std(diffs, ddof=1)) if len(diffs) > 1 else 0.0
    return prob_outperform, mean_diff, std_diff

class ICSimulator(MtSimulator):
    PRICE_KEY_ENTRY = "Open"

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.accumulated_fees = 0.0
        self.accumulated_swaps = 0.0
        self.accumulated_partial_fees = 0.0
        self.accumulated_partial_profits = 0.0

    def _create_hedged_order(self, order_type, symbol, volume, fee_in_price_units, raise_exception):
        row = self.symbols_data[symbol].loc[self.nearest_time(symbol, self.current_time)]
        order = super()._create_hedged_order(order_type, symbol, volume, fee_in_price_units, raise_exception)
        if order is not None:
            order.entry_price = float(row[self.PRICE_KEY_ENTRY])
            self._update_order_profit(order)
            self._update_order_margin(order)
            si = self.symbols_info[symbol]
            unit_ratio = self._get_unit_ratio(symbol, self.current_time)
            fee_val = fee_in_price_units * volume * si.trade_contract_size * unit_ratio
            self.accumulated_fees += fee_val
        return order

    def _create_unhedged_order(self, order_type, symbol, volume, fee, raise_exception):
        if symbol not in map(lambda order: order.symbol, self.orders):
            return super()._create_unhedged_order(order_type, symbol, volume, fee, raise_exception)
        old_order = self.symbol_orders(symbol)[0]
        if old_order.type == order_type:
            return super()._create_unhedged_order(order_type, symbol, volume, fee, raise_exception)
        if volume >= old_order.volume:
            return super()._create_unhedged_order(order_type, symbol, volume, fee, raise_exception)
        partial_profit = (volume / old_order.volume) * old_order.profit
        self.accumulated_partial_profits += partial_profit
        si = self.symbols_info[symbol]
        u_ratio = self._get_unit_ratio(symbol, self.current_time)
        partial_fee = volume * si.trade_contract_size * old_order.fee * u_ratio
        self.accumulated_partial_fees += partial_fee
        return super()._create_unhedged_order(order_type, symbol, volume, fee, raise_exception)

    def tick(self, delta_time=timedelta()):
        prev_date = self.current_time.date() if self.current_time is not NotImplemented else None
        super().tick(delta_time)
        if prev_date is not None and self.current_time.date() != prev_date:
            for od in self.orders:
                if od.symbol in ["BTCUSD"]:
                    mult = 3.0 if self.current_time.weekday() == 4 else 1.0
                else:
                    mult = 3.0 if self.current_time.weekday() == 2 else 1.0
                v = od.volume
                if od.type == OrderType.Buy:
                    symbol_swap = SWAP_LONG_CALIBRATED.get(od.symbol, 0.0)
                else:
                    symbol_swap = SWAP_SHORT_CALIBRATED.get(od.symbol, 0.0)
                swap = symbol_swap * v * mult * self._get_unit_ratio(od.symbol, self.current_time)
                self.balance += swap
                self.accumulated_swaps += swap
            self.equity = self.balance + sum(o.profit for o in self.orders)

class ICEnv(MtEnv):
    def __init__(self, sim, trading_symbols, window_size, time_points,
                 dsr_eta=0.004, target_ann_vol=0.10, rebalance_band=0.10, cost_multiplier=1.0,
                 decision_interval=16, **kw):
        self._dsr_eta, self._tgtvol, self._band = dsr_eta, target_ann_vol, rebalance_band
        self._cost_mult = cost_multiplier
        self.decision_interval = decision_interval
        super().__init__(original_simulator=sim, trading_symbols=trading_symbols,
                         window_size=window_size, time_points=time_points,
                         fee=lambda s: REAL_COST[s] * self._cost_mult, **kw)
        self.action_space = spaces.Box(low=0.0, high=1.0, shape=(len(trading_symbols),), dtype=np.float64)
        self.peak_eq = 0.0
        self._barvol = {s: float(np.nanstd(np.log(final_symbols_data[s]["Close"].loc[:STATE_INDEX[i_tr]]).diff())) for s in trading_symbols}
        self.symbol_to_idx = {s: i for i, s in enumerate(trading_symbols)}

    def _get_prices(self, keys=['Close', 'Open']):
        prices = {}
        for symbol in self.trading_symbols:
            df = self.original_simulator.symbols_data[symbol]
            aligned_df = df[keys].reindex(self.time_points, method='ffill').bfill()
            prices[symbol] = aligned_df.values
        return prices

    def _process_data(self):
        tp = pd.DatetimeIndex(self.time_points)
        pos = STATE_INDEX.get_indexer(tp)
        assert (pos >= 0).all()
        assert np.all(np.diff(pos) == 1)
        self._pos_mapping = pos
        return STATE_MATRIX[pos]

    def reset(self, seed=None, options=None):
        self.peak_eq = 0.0
        super(MtEnv, self).reset(seed=seed, options=options)
        self._truncated = False
        self._current_tick = self._start_tick
        self.simulator = copy.copy(self.original_simulator)
        self.simulator.orders = []
        self.simulator.closed_orders = []
        self.simulator.accumulated_fees = 0.0
        self.simulator.accumulated_swaps = 0.0
        self.simulator.accumulated_partial_fees = 0.0
        self.simulator.accumulated_partial_profits = 0.0
        self.simulator.balance = float(self.original_simulator.balance)
        self.simulator.equity = float(self.original_simulator.balance)
        self.simulator.margin = 0.0
        self.simulator.current_time = self.time_points[self._current_tick]
        self.history = [self._create_info()]
        obs = self._get_observation()
        info = self._create_info()
        return obs, info

    def step(self, action):
        orders_info, closed_info = self._apply_action(np.asarray(action, float))
        terminate = False
        for _ in range(self.decision_interval):
            if self._current_tick >= self._end_tick - 1:
                self._truncated = True
                break
            self._current_tick += 1
            dt = self.time_points[self._current_tick] - self.time_points[self._current_tick - 1]
            self.unwrapped.simulator.tick(dt)
            self.peak_eq = max(self.unwrapped.simulator.equity, self.peak_eq)
            if self.unwrapped.simulator.equity <= 1.0:
                terminate = True
                break
        step_reward = self._calculate_reward()
        info = self._create_info(orders=orders_info, closed_orders=closed_info, step_reward=step_reward)
        obs = self._get_observation()
        self.history.append(info)
        return obs, step_reward, terminate, self._truncated, info

    def get_directional_signal(self, symbol):
        tick = self._current_tick
        current_time = self.time_points[tick]
        df = self.unwrapped.simulator.symbols_data[symbol]
        nearest_idx = df.index.get_indexer([current_time], method='pad')[0]
        lookback = 2688 if symbol == "BTCUSD" else 11520
        if nearest_idx >= lookback:
            price_now = float(df.iloc[nearest_idx]["Close"])
            price_past = float(df.iloc[nearest_idx - lookback]["Close"])
            trend_sign = 1.0 if price_now >= price_past else -1.0
        else:
            return 0.0

        if symbol == "USDJPY":
            carry_sign = 1.0
            if "USDJPY_carry_signal" in list(STATE_COLUMNS):
                col_idx = list(STATE_COLUMNS).index("USDJPY_carry_signal")
                tp_idx = self._pos_mapping[self._current_tick]
                c_val = float(STATE_MATRIX[tp_idx, col_idx])
                carry_sign = 1.0 if c_val >= 0.0 else -1.0
            else:
                sl = SWAP_LONG_CALIBRATED.get("USDJPY", 0.0)
                ss = SWAP_SHORT_CALIBRATED.get("USDJPY", 0.0)
                if abs(sl) > 1e-6 or abs(ss) > 1e-6:
                    carry_sign = 1.0 if sl >= ss else -1.0
                else:
                    carry_sign = 1.0
            
            if trend_sign == carry_sign:
                return trend_sign
            else:
                return 0.5 * trend_sign

        return trend_sign

class MarkovRewardEnv(ICEnv):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._alpha = self._dsr_eta
        self._prior_vol = abs(math.log(0.97))
        self._ewma_ret = 0.0
        self._ewma_downside_var = self._prior_vol ** 2
        self._step_count = 0
        self.reward_branch_switches = 0
        self.last_reward_branch = None
        self.d_prev_safe_records = []

    def warm_start_dsr(self, start_tick):
        hist_vols = []
        for s in self.trading_symbols:
            close_series = self.original_simulator.symbols_data[s]["Close"]
            pos = STATE_INDEX.get_indexer([self.time_points[start_tick]], method="pad")[0]
            start_p = max(0, pos - 100)
            sub_close = close_series.iloc[start_p:pos+1]
            if len(sub_close) > 1:
                log_rets = np.log(sub_close).diff().dropna()
                downside_rets = log_rets[log_rets < 0.0]
                if len(downside_rets) > 1:
                    hist_vols.append(np.mean(downside_rets ** 2))
        if hist_vols:
            self._ewma_downside_var = float(np.mean(hist_vols))
        else:
            self._ewma_downside_var = self._prior_vol ** 2
        self._ewma_ret = 0.0

    def reset(self, seed=None, options=None):
        self._step_count = 0
        self.reward_branch_switches = 0
        self.last_reward_branch = None
        self.d_prev_safe_records.clear()
        self._ewma_ret = 0.0
        self._ewma_downside_var = self._prior_vol ** 2
        return super().reset(seed=seed, options=options)

    def _calculate_reward(self):
        prev = self.history[-1]["equity"]
        current_eq_safe = max(1.0, self.simulator.equity)
        prev_eq_safe = max(1.0, prev)
        R_t = math.log(current_eq_safe / prev_eq_safe)
        A_prev = self._ewma_ret
        D_prev = self._ewma_downside_var
        min_vol_sq = (math.log(0.97)) ** 2
        D_prev_safe = max(D_prev, min_vol_sq)
        self.d_prev_safe_records.append(D_prev_safe)
        if R_t > 0.0:
            reward = (R_t - 0.5 * A_prev) / math.sqrt(D_prev_safe)
            curr_branch = 1
        else:
            reward = (R_t * D_prev_safe - 0.5 * A_prev * (D_prev_safe + R_t ** 2)) / (D_prev_safe ** 1.5)
            curr_branch = -1
        if self.last_reward_branch is not None and curr_branch != self.last_reward_branch:
            self.reward_branch_switches += 1
        self.last_reward_branch = curr_branch
        self._ewma_ret = (1.0 - self._alpha) * A_prev + self._alpha * R_t
        self._ewma_downside_var = (1.0 - self._alpha) * D_prev + self._alpha * (min(R_t, 0.0) ** 2)
        self._step_count += 1
        return float(reward)

class TargetWeightEnv(MarkovRewardEnv):
    def __init__(self, *a, turnover_penalty_lambda=0.0, is_eval=False, decision_interval=16, **kw):
        self._turnover_penalty_lambda = turnover_penalty_lambda
        self._is_eval = is_eval
        super().__init__(*a, decision_interval=decision_interval, **kw)
        d = dict(self.observation_space.spaces)
        d["pos_state"] = spaces.Box(-np.inf, np.inf, shape=(len(self.trading_symbols),), dtype=np.float64)
        d["dsr_state"] = spaces.Box(-np.inf, np.inf, shape=(2,), dtype=np.float64)
        self.observation_space = spaces.Dict(d)
        self._last_turnover = 0.0
        self._last_actions = np.zeros(len(self.trading_symbols), dtype=np.float64)
        self._action_diffs = []
        self.accumulated_raw_rewards = 0.0
        self.accumulated_turnover_penalties = 0.0
        self.accumulated_norm_raw_weighted = 0.0
        self.accumulated_norm_pen_weighted = 0.0
        self._last_norm_raw_weighted = 0.0
        self._last_norm_pen_weighted = 0.0
        self._last_weights = np.zeros(len(self.trading_symbols), dtype=np.float64)
        self.raw_tracker = EmaVarianceTracker(alpha=0.01, initial_var=1.0, floor=1e-3)
        self.pen_tracker = EmaVarianceTracker(alpha=0.01, initial_var=0.1, floor=1e-3)
        self.rollout_raw_rewards = []
        self.rollout_penalties = []
        self.history_proxy_rewards = []
        self.history_true_pnls = []

    def _calculate_reward(self):
        raw = super()._calculate_reward()
        pen = float(self._turnover_penalty_lambda * self._last_turnover)
        total = raw - pen
        self.rollout_raw_rewards.append(float(raw))
        self.rollout_penalties.append(float(pen))
        self.accumulated_raw_rewards += float(raw)
        self.accumulated_turnover_penalties += float(pen)
        self.accumulated_norm_raw_weighted += float(raw)
        self.accumulated_norm_pen_weighted += float(pen)
        return float(total)

    def copy_trackers_from(self, other_env):
        self.raw_tracker.mean = other_env.raw_tracker.mean
        self.raw_tracker.var = other_env.raw_tracker.var
        self.pen_tracker.mean = other_env.pen_tracker.mean
        self.pen_tracker.var = other_env.pen_tracker.var

    def _current_weights(self):
        eq = max(self.unwrapped.simulator.equity, 1e-9)
        ws = []
        tp_idx = self._pos_mapping[self._current_tick]
        for s in self.trading_symbols:
            si = self.unwrapped.simulator.symbols_info[s]
            px = self.unwrapped.simulator.price_at(s, self.unwrapped.simulator.current_time)["Close"]
            s_idx = self.symbol_to_idx[s]
            current_vol = float(VOL_MATRIX[tp_idx, s_idx])
            ann = current_vol * math.sqrt(96 * 252)
            cur_lots = sum(o.volume * o.type.sign for o in self.unwrapped.simulator.symbol_orders(s))
            unit_ratio = self.unwrapped.simulator._get_unit_ratio(s, self.unwrapped.simulator.current_time)
            notional_per_lot = px * si.trade_contract_size * unit_ratio
            denom = eq * (self._tgtvol / (ann + 1e-12)) / (notional_per_lot + 1e-12)
            ws.append(cur_lots / (denom + 1e-12))
        return np.array(ws, np.float64)

    def _get_observation(self):
        obs = super()._get_observation()
        if self._is_eval:
            if not hasattr(self, "feature_normalizer") or self.feature_normalizer is None:
                self.feature_normalizer = OnlineFeatureNormalizer(obs["features"].shape, alpha=0.01)
            obs["features"] = self.feature_normalizer.update(obs["features"].astype(np.float32))
        obs["pos_state"] = self._current_weights()
        obs["dsr_state"] = np.array([self._ewma_ret, self._ewma_downside_var], dtype=np.float64)
        return obs

    def reset(self, seed=None, options=None):
        self._last_turnover = 0.0
        self._last_actions = np.zeros(len(self.trading_symbols), dtype=np.float64)
        self._action_diffs.clear()
        self.accumulated_raw_rewards = 0.0
        self.accumulated_turnover_penalties = 0.0
        self.accumulated_norm_raw_weighted = 0.0
        self.accumulated_norm_pen_weighted = 0.0
        self._last_norm_raw_weighted = 0.0
        self._last_norm_pen_weighted = 0.0
        self._last_weights = np.zeros(len(self.trading_symbols), dtype=np.float64)

        preserve = False
        if options is not None and isinstance(options, dict):
            preserve = options.get("preserve_trackers", False)

        if not preserve:
            self.raw_tracker = EmaVarianceTracker(alpha=0.01, initial_var=1.0, floor=1e-3)
            self.pen_tracker = EmaVarianceTracker(alpha=0.01, initial_var=0.1, floor=1e-3)

        self.feature_normalizer = None

        self.rollout_raw_rewards = self.rollout_raw_rewards[-2048:]
        self.rollout_penalties = self.rollout_penalties[-2048:]
        self.history_proxy_rewards = []
        self.history_true_pnls = []
        return super().reset(seed=seed, options=options)

    def _apply_action(self, w):
        orders_info = {}
        closed_info = {s: [] for s in self.trading_symbols}
        eq = self.unwrapped.simulator.equity
        turnover = 0.0
        w_clipped = np.clip(w, 0.0, 1.0)
        diffs = np.abs(w_clipped - self._last_actions)
        self._action_diffs.extend(diffs.tolist())
        self._last_actions = w_clipped.copy()
        for i, s in enumerate(self.trading_symbols):
            si = self.unwrapped.simulator.symbols_info[s]
            px = self.unwrapped.simulator.price_at(s, self.unwrapped.simulator.current_time)["Open"]
            tp_idx = self._pos_mapping[self._current_tick]
            s_idx = self.symbol_to_idx[s]
            current_vol = float(VOL_MATRIX[tp_idx, s_idx])
            ann = current_vol * math.sqrt(96 * 252)
            u_i = float(w_clipped[i])
            dir_i = float(self.get_directional_signal(s))
            position_w_i = u_i * dir_i
            unit_ratio = self.unwrapped.simulator._get_unit_ratio(s, self.unwrapped.simulator.current_time)
            notional_per_lot = px * si.trade_contract_size * unit_ratio
            scale = eq * (self._tgtvol / (ann + 1e-12)) / (notional_per_lot + 1e-12)
            cur = self.unwrapped.simulator.symbol_orders(s)
            cur_lots = sum(o.volume * o.type.sign for o in cur)

            c_i = REAL_COST[s] * self._cost_mult
            gamma_i = 1.0 / (1.0 + 100.0 * c_i * (ann + 1e-6))
            gamma_i = max(0.05, min(1.0, gamma_i))

            tgt_lots = (1.0 - gamma_i) * cur_lots + gamma_i * position_w_i * scale
            q_lots = round(tgt_lots / si.volume_step) * si.volume_step
            if abs(q_lots) < si.volume_min:
                q_lots = 0.0
            delta = q_lots - cur_lots
            turnover += abs(delta) / (scale + 1e-12)

            band_thr = max(si.volume_min, max(abs(tgt_lots), abs(cur_lots)) * self._band)
            if abs(delta) < band_thr:
                orders_info[s] = dict(hold=True, target=tgt_lots, current=cur_lots)
                continue
            try:
                if cur_lots != 0.0 and (q_lots == 0.0 or np.sign(q_lots) != np.sign(cur_lots)):
                    for o in list(cur):
                        p = self.unwrapped.simulator.close_order(o)
                        closed_info[s].append(dict(order_id=o.id, profit=p))
                    if abs(q_lots) >= si.volume_min:
                        ot = OrderType.Buy if q_lots > 0 else OrderType.Sell
                        od = self.unwrapped.simulator.create_order(ot, s, self._get_modified_volume(s, abs(q_lots)), REAL_COST[s] * self._cost_mult * px)
                        orders_info[s] = dict(hold=False, order_id=od.id, volume=od.volume, target=tgt_lots)
                    else:
                        orders_info[s] = dict(hold=False, order_id=None, volume=0.0, target=tgt_lots)
                else:
                    dv = abs(delta)
                    if dv >= si.volume_min:
                        ot = OrderType.Buy if delta > 0 else OrderType.Sell
                        od = self.unwrapped.simulator.create_order(ot, s, self._get_modified_volume(s, dv), REAL_COST[s] * self._cost_mult * px)
                        orders_info[s] = dict(hold=False, order_id=od.id, volume=od.volume, target=tgt_lots)
                    else:
                        orders_info[s] = dict(hold=True, target=tgt_lots, current=cur_lots)
            except ValueError as e:
                orders_info[s] = dict(hold=False, error=str(e), target=tgt_lots)
        self._last_turnover = float(turnover)
        return orders_info, closed_info

class BootstrapFix(gym.Wrapper):
    def step(self, a):
        obs, r, term, trunc, info = self.env.step(a)
        if trunc and not term:
            info["TimeLimit.truncated"] = True
            info["terminal_observation"] = obs
        return obs, r, term, trunc, info

class SubEpisodeEnv(gym.Wrapper):
    def __init__(self, env, ep_len=5000):
        super().__init__(env)
        self.ep_len = ep_len

    def reset(self, seed=None, options=None):
        obs, info = self.env.reset(seed=seed, options=options)
        lo = self.unwrapped._start_tick
        hi = self.unwrapped._end_tick - self.ep_len - 10
        start = int(self.unwrapped.np_random.integers(lo, hi))
        self.unwrapped._current_tick = start
        self.unwrapped.simulator.current_time = self.unwrapped.time_points[start]
        if hasattr(self.unwrapped, "warm_start_dsr"):
            self.unwrapped.warm_start_dsr(start)
        self._stop = start + self.ep_len
        return self.unwrapped._get_observation(), info

    def step(self, a):
        obs, r, term, trunc, info = self.env.step(a)
        if self.unwrapped._current_tick >= self._stop:
            trunc = True
        return obs, r, term, trunc, info

class HarnessASanityWrapper(gym.Wrapper):
    def __init__(self, env):
        super().__init__(env)
        self.W, self.D = self.unwrapped.observation_space["features"].shape
        self.num_symbols = len(self.unwrapped.trading_symbols)
        self.unwrapped.get_directional_signal = lambda s: 1.0

    def _make_synthetic_obs(self, obs, tick):
        features = np.zeros((self.W, self.D), dtype=np.float32)
        for w in range(self.W):
            for i in range(self.num_symbols):
                phase = i * math.pi / 3.0
                t = tick - (self.W - 1 - w)
                features[w, i] = 0.5 * math.sin(t / 5.0 + phase)
        obs["features"] = features
        return obs

    def reset(self, seed=None, options=None):
        self.unwrapped.get_directional_signal = lambda s: 1.0
        obs, info = self.env.reset(seed=seed, options=options)
        obs = self._make_synthetic_obs(obs, self.unwrapped._current_tick)
        return obs, info

    def step(self, action):
        obs, r, term, trunc, info = self.env.step(action)
        obs = self._make_synthetic_obs(obs, self.unwrapped._current_tick)
        return obs, r, term, trunc, info

class MLPExtractorDSR(BaseFeaturesExtractor):
    def __init__(self, observation_space, d_model=64):
        W, D = observation_space["features"].shape
        flat_dim = W * D
        super().__init__(observation_space, features_dim=d_model + 8)
        self.features_flat_dim = flat_dim
        self.feature_mlp = nn.Sequential(
            nn.Linear(flat_dim, d_model),
            nn.LayerNorm(d_model),
            nn.Tanh(),
            nn.Linear(d_model, d_model),
            nn.Tanh()
        )
        n_ord = int(np.prod(observation_space["orders"].shape))
        n_extra = 0
        self._has_dsr = "dsr_state" in observation_space.spaces
        self._has_pos = "pos_state" in observation_space.spaces
        if self._has_dsr:
            n_extra += 2
        if self._has_pos:
            n_extra += int(np.prod(observation_space["pos_state"].shape))
        self.acct = nn.Sequential(
            nn.Linear(3 + n_ord + n_extra, 8),
            nn.Tanh()
        )

    def forward(self, obs):
        x = obs["features"].flatten(1)
        z = self.feature_mlp(x)
        scale = obs["equity"].abs() + 1e-6
        parts = [
            obs["balance"] / scale,
            obs["equity"] / scale,
            obs["margin"] / scale,
            obs["orders"].flatten(1)
        ]
        if self._has_dsr:
            parts.append(obs["dsr_state"])
        if self._has_pos:
            parts.append(obs["pos_state"])
        acct_in = torch.cat(parts, dim=1)
        return torch.cat([z, self.acct(acct_in)], dim=1)

class PopArtTracker:
    def __init__(self, beta=0.05):
        self.beta = beta
        self.mu = 0.0
        self.sigma = 1.0

    def update(self, batch_returns):
        old_mu = self.mu
        old_sigma = self.sigma
        batch_mu = float(np.mean(batch_returns))
        batch_var = float(np.var(batch_returns))
        self.mu = (1.0 - self.beta) * old_mu + self.beta * batch_mu
        new_var = (1.0 - self.beta) * (old_sigma ** 2) + self.beta * batch_var
        self.sigma = math.sqrt(max(new_var, 1e-4))
        return old_mu, old_sigma, self.mu, self.sigma

class EVTracker(BaseCallback):
    def __init__(self, every, value_net_module, validation_env=None, verbose=0, silent=True):
        super().__init__(verbose)
        self.every = every
        self.value_net_module = value_net_module
        self.validation_env = validation_env
        self.grad_tracker = GradNormTracker(value_net_module)
        self.lines = []
        self.silent = silent
        self.popart = PopArtTracker(beta=0.05)
        self._prev_actions = None
        self.should_stop = False
        self.best_val_pnl = -1e9
        self.patience_counter = 0
        self.ev_history = []
        self.val_pnl_history = []
        self.anomalies = []

    def _on_step(self) -> bool:
        if hasattr(self, "should_stop") and self.should_stop:
            return False
        return True

    def _on_rollout_end(self) -> None:
        step = self.num_timesteps
        returns_raw = self.model.rollout_buffer.returns.copy()
        old_mu, old_sigma, new_mu, new_sigma = self.popart.update(returns_raw)
        with torch.no_grad():
            w = self.model.policy.value_net.weight
            b = self.model.policy.value_net.bias
            w.copy_((old_sigma / new_sigma) * w)
            b.copy_((old_sigma * b + old_mu - new_mu) / new_sigma)
        self.model.rollout_buffer.returns = (self.model.rollout_buffer.returns - new_mu) / new_sigma
        self.model.rollout_buffer.values = (self.model.rollout_buffer.values - new_mu) / new_sigma
        self.model.rollout_buffer.advantages = self.model.rollout_buffer.advantages * (old_sigma / new_sigma)
        returns = self.model.rollout_buffer.returns.flatten()
        values = self.model.rollout_buffer.values.flatten()
        ev = float(explained_variance(values, returns))
        ev = max(-10.0, ev)
        self.ev_history.append(ev)
        val_ev = 0.0
        val_var = 0.0
        oos_loss = 0.0
        advantages = self.model.rollout_buffer.advantages.flatten()
        adv_std = float(np.std(advantages))
        rewards = self.model.rollout_buffer.rewards.flatten()
        rew_val_ratio = float(np.mean(np.abs(rewards)) / (np.mean(np.abs(values)) + 1e-12))
        srank_val = compute_rollout_srank(self.model)
        env = self.training_env.envs[0]
        while hasattr(env, "env"):
            env = env.env
        raw_rews = np.array(env.rollout_raw_rewards[-self.model.n_steps:])
        pens = np.array(env.rollout_penalties[-self.model.n_steps:])
        obs_rollout = self.model.rollout_buffer.observations
        act_rollout = self.model.rollout_buffer.actions
        if len(raw_rews) >= self.model.n_steps:
            grad_cos = compute_pcgrad_cosine(self.model, obs_rollout, act_rollout, raw_rews, pens)
        else:
            grad_cos = 0.0

        obs_first_batch = {k: v[0] for k, v in obs_rollout.items()}
        dormant_val = compute_dual_zero_dormant(self.model.policy, obs_first_batch)

        churn_val = 0.0
        try:
            policy = self.model.policy
            policy.eval()
            obs_dict = {}
            for k, v in self.model.rollout_buffer.observations.items():
                obs_dict[k] = to_float_tensor(v[:128], policy.device).reshape((min(128, v.shape[0]*v.shape[1]),) + v.shape[2:])
            with torch.no_grad():
                dist = policy.get_distribution(obs_dict)
                curr_actions = dist.mode()
            if self._prev_actions is not None:
                churn_val = float(torch.abs(curr_actions - self._prev_actions).mean().item())
                self._prev_actions = curr_actions.clone()
            else:
                self._prev_actions = curr_actions.clone()
            policy.train()
        except Exception:
            pass

        if grad_cos < 0.0:
            self.anomalies.append(f"GradCos negative: {grad_cos:.3f} at step {step}")
        if dormant_val > 0.1:
            self.anomalies.append(f"Dual-zero dormant high: {dormant_val:.2f} at step {step}")

        val_pnl = -1e9
        if self.validation_env is not None:
            self.validation_env.unwrapped.copy_trackers_from(env.unwrapped)
            val_res = rollout(self.validation_env, lambda o, e: self.model.predict(o, deterministic=True)[0], seed=42)
            val_pnl = val_res["final_eq"] - 10000.0
            self.val_pnl_history.append(val_pnl)

            obs, _ = self.validation_env.reset(seed=42, options={"preserve_trackers": True})
            val_rewards, val_values = [], []
            done = False
            for _ in range(200):
                with torch.no_grad():
                    obs_tensor, _ = self.model.policy.obs_to_tensor(obs)
                    val = self.model.policy.predict_values(obs_tensor).cpu().numpy().item()
                    val_unnorm = val * self.popart.sigma + self.popart.mu
                val_values.append(val_unnorm)
                obs, r, term, trunc, info = self.validation_env.step(self.model.predict(obs, deterministic=True)[0])
                val_rewards.append(r)
                if term or trunc:
                    break
            gamma = 0.99
            val_returns = []
            discounted_sum = 0.0
            for r_t in reversed(val_rewards):
                discounted_sum = r_t + gamma * discounted_sum
                val_returns.insert(0, discounted_sum)
            val_returns = np.array(val_returns)
            val_values = np.array(val_values)[:len(val_returns)]
            val_var = float(np.var(val_returns)) if len(val_returns) > 1 else 0.0
            if len(val_returns) > 1:
                val_ev = float(explained_variance(val_values, val_returns))
                val_ev = max(-10.0, val_ev)
                oos_loss = float(np.mean((val_values - val_returns) ** 2))

        if step > 8000:
            if val_pnl > self.best_val_pnl:
                self.best_val_pnl = val_pnl
                self.patience_counter = 0
            else:
                self.patience_counter += 1
            if self.patience_counter >= 12:
                self.should_stop = True

        loss = self.logger.name_to_value.get("train/loss", float('nan'))
        entropy = self.logger.name_to_value.get("train/entropy_loss", float('nan'))
        kl = self.logger.name_to_value.get("train/approx_kl", 0.0)
        clip = self.logger.name_to_value.get("train/clip_fraction", 0.0)
        history_slice = env.history
        mdd = 0.0
        pnl_train = 0.0
        churn = 0.0
        bndv = 0.0
        if len(history_slice) > 1:
            equities = np.array([h["equity"] for h in history_slice])
            returns_tr = np.diff(equities) / (equities[:-1] + 1e-12)
            if len(returns_tr) > 0:
                cum_returns = equities / (equities[0] + 1e-12)
                running_max = np.maximum.accumulate(cum_returns)
                drawdowns = (running_max - cum_returns) / (running_max + 1e-12)
                mdd = float(np.max(drawdowns)) * 100.0
            pnl_train = float(equities[-1] - equities[0])
            if hasattr(env, "_action_diffs") and len(env._action_diffs) > 0:
                churn = float(np.mean(env._action_diffs))
            total_symbol_steps = 0
            violated_symbol_steps = 0
            for h in history_slice:
                orders = h.get("orders", {})
                if orders:
                    for s, o_info in orders.items():
                        if isinstance(o_info, dict):
                            total_symbol_steps += 1
                            if not o_info.get("hold", True):
                                violated_symbol_steps += 1
            if total_symbol_steps > 0:
                bndv = (violated_symbol_steps / total_symbol_steps) * 100.0

        ev_str = f"{ev:>+6.3f}" if not math.isnan(ev) else "nan"
        if ev == 0.0: ev_str = "0.000"
        val_ev_str = f"{val_ev:>+6.3f}" if not math.isnan(val_ev) else "nan"
        if val_ev == 0.0: val_ev_str = "0.000"
        val_var_str = f"{val_var:.1e}"
        srank_str = f"{srank_val:.2f}"
        loss_str = f"{loss:.3f}" if isinstance(loss, (int, float)) and not math.isnan(loss) else "nan"
        oos_loss_str = f"{oos_loss:.3f}" if isinstance(oos_loss, (int, float)) and not math.isnan(oos_loss) else "nan"
        if oos_loss == 0.0: oos_loss_str = "0.000"
        entropy_str = f"{entropy:.4f}" if isinstance(entropy, (int, float)) and not math.isnan(entropy) else "nan"
        mdd_str = f"{mdd:.1f}%"
        pnl_str = f"{pnl_train:>+8.1f}" if abs(pnl_train) > 1e-6 else "0.0"
        grad_str = f"{self.grad_tracker.pop_mean():.1e}"
        kl_str = f"{kl:.1e}"
        clip_str = f"{clip:.3f}"
        churn_str = f"{churn:.3f}"
        bndv_str = f"{bndv:.1f}%"

        line = (
            f"{step:<8d} | "
            f"{ev_str:<6s} | "
            f"{val_ev_str:<7s} | "
            f"{val_var_str:<7s} | "
            f"{srank_str:<5s} | "
            f"{loss_str:<8s} | "
            f"{oos_loss_str:<8s} | "
            f"{entropy_str:<7s} | "
            f"{mdd_str:<5s} | "
            f"{pnl_str:<9s} | "
            f"{grad_str:<7s} | "
            f"{kl_str:<6s} | "
            f"{clip_str:<5s} | "
            f"{churn_str:<5s} | "
            f"{bndv_str:<5s} | "
            f"{adv_std:<6.3f} | "
            f"{rew_val_ratio:<8.3f} | "
            f"{churn_val:<7.2f}"
        )
        self.lines.append(line)
        if not self.silent:
            print(line, flush=True)

class BehaviorCallback(BaseCallback):
    def __init__(self, probe_env, every, verbose=0):
        super().__init__(verbose)
        self.probe_env = probe_env
        self.every = every
        self.rows = []

    def _on_step(self) -> bool:
        if self.num_timesteps % self.every == 0:
            res = rollout(self.probe_env, lambda o, e: self.model.predict(o, deterministic=True)[0], seed=42)
            act_hist = res["actions_history"]
            expo_parts = []
            for i, s in enumerate(self.probe_env.unwrapped.trading_symbols):
                s_act = act_hist[:, i]
                mean_val = np.mean(s_act)
                std_val = np.std(s_act)
                skew_val = stats.skew(s_act) if len(s_act) > 2 and np.std(s_act) > 1e-9 else float('nan')
                short_s = s[:3]
                expo_parts.append(f"{short_s}:{mean_val:>+5.2f}({std_val:.2f},{skew_val:>+4.1f})")
            expo_str = " | ".join(expo_parts)
            churn_index = float(np.mean(np.abs(np.diff(act_hist, axis=0)))) if len(act_hist) > 1 else 0.0
            row = {
                'step': self.num_timesteps,
                'pnl': res["final_eq"] - 10000.0,
                'trades_1k': res["trades_per_1k"],
                'hold': res["mean_hold_bars"],
                'in_mkt': res["pct_in_market"],
                'churn_index': churn_index,
                'expo_str': expo_str
            }
            self.rows.append(row)
        return True

def run_bc_oracle_probe(env_train, oracle_policy_fn, seed=42, num_samples=2000, epochs=20):
    policy = PPO("MultiInputPolicy", env_train, seed=seed, verbose=0,
                 policy_kwargs=dict(features_extractor_class=MLPExtractorDSR, net_arch=[64]),
                 learning_rate=1e-3, device="cuda" if torch.cuda.is_available() else "cpu").policy
    optimizer = torch.optim.Adam(policy.parameters(), lr=1e-3)
    obs_list = []
    act_list = []
    obs, _ = env_train.reset(seed=seed)
    for _ in range(num_samples):
        act = oracle_policy_fn(env_train)
        obs_list.append(copy.deepcopy(obs))
        act_list.append(act.copy())
        obs, _, term, trunc, _ = env_train.step(act)
        if term or trunc:
            obs, _ = env_train.reset()
    loss_val = 0.0
    for epoch in range(epochs):
        policy.train()
        batch_losses = []
        for i in range(0, len(obs_list), 64):
            batch_obs_raw = obs_list[i : i + 64]
            batch_act_raw = act_list[i : i + 64]
            tensor_obs = {}
            for k in batch_obs_raw[0].keys():
                v_arr = np.array([o[k] for o in batch_obs_raw])
                tensor_obs[k] = to_float_tensor(v_arr, policy.device)
            target_act = torch.as_tensor(np.array(batch_act_raw), dtype=torch.float32, device=policy.device)
            dist = policy.get_distribution(tensor_obs)
            pred_act = dist.mode()
            loss = nn.MSELoss()(pred_act, target_act)
            optimizer.zero_grad()
            loss.backward()
            optimizer.step()
            batch_losses.append(loss.item())
        loss_val = float(np.mean(batch_losses))
    bc_passed = loss_val < 0.05
    return loss_val, bc_passed

def get_fresh_sim(base_sim):
    new_sim = copy.copy(base_sim)
    new_sim.accumulated_fees = 0.0
    new_sim.accumulated_swaps = 0.0
    new_sim.accumulated_partial_fees = 0.0
    new_sim.accumulated_partial_profits = 0.0
    new_sim.orders = []
    new_sim.closed_orders = []
    return new_sim

def rollout(env, policy_fn, seed):
    obs, _ = env.reset(seed=seed)
    eqs = [env.unwrapped.simulator.equity]
    trades, pos_bars = 0, 0
    hold_lengths, cur_hold = [], 0
    closed_profits = []
    symbol_closed_pnl = defaultdict(float)
    exposures = []
    step_rewards = []
    actions_history = []
    done = False
    sim_ref = env.unwrapped.simulator
    sim_ref.accumulated_fees = 0.0
    sim_ref.accumulated_swaps = 0.0
    sim_ref.accumulated_partial_fees = 0.0
    sim_ref.accumulated_partial_profits = 0.0
    while not done:
        curr_w = env.unwrapped._current_weights()
        net_abs_exposure = float(np.sum(np.abs(curr_w)))
        exposures.append(net_abs_exposure)
        a_val = policy_fn(obs, env)
        actions_history.append(a_val)
        obs, r, term, trunc, info = env.step(a_val)
        step_rewards.append(r)
        done = term or trunc
        eqs.append(info["equity"])
        od = info.get("orders", {})
        opened = sum(1 for v in od.values() if isinstance(v, dict) and not v.get("hold", True) and not v.get("error"))
        trades += opened
        in_mkt = len(env.unwrapped.simulator.orders) > 0
        pos_bars += int(in_mkt)
        cur_hold = cur_hold + 1 if in_mkt else (hold_lengths.append(cur_hold) or 0) if cur_hold else 0
        closed = info.get("closed_orders", {})
        if isinstance(closed, dict):
            for s, cl_list in closed.items():
                for c_item in cl_list:
                    if isinstance(c_item, dict) and "profit" in c_item:
                        p_val = float(c_item["profit"])
                        closed_profits.append(p_val)
                        symbol_closed_pnl[s] += p_val

        step_actual_equity = env.unwrapped.simulator.equity
        step_net_pnl = step_actual_equity - 10000.0
        step_fees_closed = sum(o.volume * sim_ref.symbols_info[o.symbol].trade_contract_size * o.fee * sim_ref._get_unit_ratio(o.symbol, o.exit_time) for o in sim_ref.closed_orders)
        step_fees_open = sum(o.volume * sim_ref.symbols_info[o.symbol].trade_contract_size * o.fee * sim_ref._get_unit_ratio(o.symbol, sim_ref.current_time) for o in sim_ref.orders)
        step_total_fees = step_fees_closed + step_fees_open + sim_ref.accumulated_partial_fees
        step_realized_profits = sum(o.profit for o in sim_ref.closed_orders) + sim_ref.accumulated_partial_profits
        step_gross_raw_realized = step_realized_profits + step_fees_closed + sim_ref.accumulated_partial_fees
        step_gross_raw_unrealized = sum(o.profit for o in sim_ref.orders) + step_fees_open
        step_reconciled = step_gross_raw_realized + step_gross_raw_unrealized + sim_ref.accumulated_swaps - step_total_fees
        step_residual = step_net_pnl - step_reconciled
        if abs(step_residual) > 1e-2:
            raise AssertionError(f"PnL reconciliation divergence at tick {env.unwrapped._current_tick}: actual={step_net_pnl:.2f}, reconciled={step_reconciled:.2f}, residual={step_residual:.2f}")

    if cur_hold:
        hold_lengths.append(cur_hold)
    eqs = np.asarray(eqs, float)
    n = len(eqs) - 1
    ret = np.diff(eqs) / (np.abs(eqs[:-1]) + 1e-12)
    dd = float(np.max(np.maximum.accumulate(eqs) - eqs))
    downside_squared = np.minimum(ret, 0.0) ** 2
    n_downside_bars = int(np.sum(ret < 0.0))
    down_std = math.sqrt(np.mean(downside_squared))
    unreliable_sortino = n_downside_bars < 30
    if down_std > 1e-12:
        sortino = float(ret.mean() / down_std * math.sqrt(96 * 252))
    else:
        sortino = 0.0
    skewness = float(stats.skew(ret)) if len(ret) > 2 else 0.0
    get_kurtosis_val = float(stats.kurtosis(ret)) if len(ret) > 2 else 0.0
    cvar_95 = float(np.mean(ret[ret <= np.quantile(ret, 0.05)])) if len(ret) > 10 else 0.0
    pos_profits = [p for p in closed_profits if p > 0]
    neg_profits = [abs(p) for p in closed_profits if p < 0]
    profit_factor = float(sum(pos_profits) / (sum(neg_profits) + 1e-12)) if neg_profits else (99.9 if pos_profits else 1.0)
    win_rate = float(len(pos_profits) / (len(closed_profits) + 1e-12) * 100.0) if closed_profits else 0.0
    gross_profit = float(sum(closed_profits))
    net_pnl = float(eqs[-1] - eqs[0])

    actual_fees_closed = sum(o.volume * sim_ref.symbols_info[o.symbol].trade_contract_size * o.fee * sim_ref._get_unit_ratio(o.symbol, o.exit_time) for o in sim_ref.closed_orders)
    actual_fees_open = sum(o.volume * sim_ref.symbols_info[o.symbol].trade_contract_size * o.fee * sim_ref._get_unit_ratio(o.symbol, sim_ref.current_time) for o in sim_ref.orders)
    total_actual_fees = actual_fees_closed + actual_fees_open + sim_ref.accumulated_partial_fees
    sim_ref.accumulated_fees = total_actual_fees

    realized_profits_total = sum(o.profit for o in sim_ref.closed_orders) + sim_ref.accumulated_partial_profits
    gross_raw_realized = realized_profits_total + actual_fees_closed + sim_ref.accumulated_partial_fees
    gross_raw_unrealized = sum(o.profit for o in sim_ref.orders) + actual_fees_open
    reconciled_pnl = gross_raw_realized + gross_raw_unrealized + sim_ref.accumulated_swaps - sim_ref.accumulated_fees
    residual = net_pnl - reconciled_pnl

    cost_paid = float(gross_profit - net_pnl)
    cost_drag_bps = float((cost_paid / (eqs[0] + 1e-12)) * 10000.0)
    spread_cost_bps = float((sim_ref.accumulated_fees / (eqs[0] + 1e-12)) * 10000.0)
    swap_cost_bps = float((-sim_ref.accumulated_swaps / (eqs[0] + 1e-12)) * 10000.0)
    unrealized_pnl_at_end = sum(o.profit for o in sim_ref.orders)
    pct_of_total_pnl_from_open_positions = float(unrealized_pnl_at_end / (net_pnl + 1e-12) * 100.0)
    if len(exposures) > 2 and np.std(exposures) > 1e-12 and np.std(step_rewards) > 1e-12:
        exposure_reward_corr, _ = stats.pearsonr(exposures, step_rewards)
        exposure_reward_corr = float(np.nan_to_num(exposure_reward_corr))
    else:
        exposure_reward_corr = float('nan')
    actions_history = np.array(actions_history)

