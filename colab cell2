def compute_cscv_pbo(all_returns_list):
    N = len(all_returns_list)
    if N < 2:
        return 0.0
    T = len(all_returns_list[0])
    M = 6
    block_size = T // M
    if block_size < 10:
        return 0.0
    purge_size = int(block_size * 0.10)
    import itertools
    all_indices = list(range(M))
    comb_is = list(itertools.combinations(all_indices, M // 2))
    overfit_count = 0
    total_combinations = len(comb_is)
    for indices_is in comb_is:
        indices_oos = [idx for idx in all_indices if idx not in indices_is]
        is_srs = []
        oos_srs = []
        for i in range(N):
            r = all_returns_list[i]
            purged_is_parts = []
            for idx in indices_is:
                start = idx * block_size
                end = (idx + 1) * block_size if idx < M - 1 else T
                if idx - 1 in indices_oos:
                    start += purge_size
                if idx + 1 in indices_oos:
                    end -= purge_size
                if start < end:
                    purged_is_parts.append(r[start:end])
            oos_parts = []
            for idx in indices_oos:
                start = idx * block_size
                end = (idx + 1) * block_size if idx < M - 1 else T
                oos_parts.append(r[start:end])
            if len(purged_is_parts) == 0 or len(oos_parts) == 0:
                is_srs.append(-1e9)
                oos_srs.append(-1e9)
                continue
            is_ret = np.concatenate(purged_is_parts)
            oos_ret = np.concatenate(oos_parts)
            def get_sr(ret):
                std = np.std(ret, ddof=1)
                return np.mean(ret) / std if std > 1e-9 else -1e9
            is_srs.append(get_sr(is_ret))
            oos_srs.append(get_sr(oos_ret))
        best_is_idx = np.argmax(is_srs)
        median_oos = np.median(oos_srs)
        if oos_srs[best_is_idx] < median_oos:
            overfit_count += 1
    pbo = overfit_count / total_combinations
    return pbo

def compute_dsr(all_returns_list, best_idx):
    best_returns = all_returns_list[best_idx]
    T = len(best_returns)
    if T < 3:
        return 0.0, 0.0, 0.0
    srs = []
    for r in all_returns_list:
        std = np.std(r, ddof=1)
        srs.append(np.mean(r) / std if std > 1e-9 else 0.0)
    best_sr = srs[best_idx]
    sigma_cross_std = np.std(srs, ddof=1) if len(srs) > 1 else 0.0
    if sigma_cross_std < 1e-9:
        sigma_cross_std = 1.0 / math.sqrt(T)
    N = len(all_returns_list) * 3
    gamma_em = 0.5772156649015329
    z1 = stats.norm.ppf(1 - 1.0 / N)
    z2 = stats.norm.ppf(1 - 1.0 / (N * math.e))
    sr_star = sigma_cross_std * ((1.0 - gamma_em) * z1 + gamma_em * z2)
    μ3 = stats.skew(best_returns, nan_policy='omit')
    excess_kurt = stats.kurtosis(best_returns, fisher=True, nan_policy='omit')
    μ4 = excess_kurt + 3.0
    var_sr = (1.0 / (T - 1)) * (1.0 - μ3 * best_sr + ((μ4 - 1.0) / 4.0) * best_sr**2)
    if var_sr <= 0:
        return 0.0, best_sr, sr_star
    sigma_sr = math.sqrt(var_sr)
    z_score = (best_sr - sr_star) / sigma_sr
    dsr_prob = stats.norm.cdf(z_score)
