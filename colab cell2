def calculate_psi(train_col, val_col, num_bins=10):
    percentiles = np.linspace(0, 100, num_bins + 1)
    bin_edges = np.percentile(train_col, percentiles)
    bin_edges = np.unique(bin_edges)
    if len(bin_edges) < 2:
        return 0.0
    train_counts, _ = np.histogram(train_col, bins=bin_edges)
    val_counts, _ = np.histogram(val_col, bins=bin_edges)
    train_probs = train_counts / len(train_col)
    val_probs = val_counts / len(val_col)
    train_probs = np.clip(train_probs, 1e-4, 1.0)
    train_probs /= np.sum(train_probs)
    val_probs = np.clip(val_probs, 1e-4, 1.0)
    val_probs /= np.sum(val_probs)
    psi_value = np.sum((train_probs - val_probs) * np.log(train_probs / val_probs))
    return float(psi_value)

def run_ks_test(train_col, val_col):
    res = stats.ks_2samp(train_col, val_col)
    return float(res.statistic), float(res.pvalue)

def run_distribution_shift_diagnostic(model=None):
    train_feats = STATE_MATRIX[:i_tr]
    val_feats = STATE_MATRIX[i_tr + EMBARGO:]
    num_features = train_feats.shape[1]
    corrs = [0.0] * num_features
    if model is not None:
        try:
            sim_local = ICSimulator(unit="USD", balance=10_000., leverage=100., hedge=False)
            sim_local.symbols_info = symbols_info_dict
            sim_local.symbols_data = {s: final_symbols_data[s].loc[STATE_INDEX] for s in symbols}
            env_val_diag = BootstrapFix(SubEpisodeEnv(TargetWeightEnv(get_fresh_sim(sim_local), symbols, WINDOW, tp_val, is_eval=True, decision_interval=16), ep_len=1000))
            corrs = compute_shift_error_correlation(env_val_diag, model, 42)
        except Exception:
            pass
    rows = []
    major_shift_count = 0
    for idx in range(min(num_features, 10)):
        col_name = STATE_COLUMNS[idx] if idx < len(STATE_COLUMNS) else f"Col_{idx}"
        train_col = train_feats[:, idx]
        val_col = val_feats[:, idx]
        psi_val = calculate_psi(train_col, val_col)
        ks_stat, p_val = run_ks_test(train_col, val_col)
        corr_val = corrs[idx] if idx < len(corrs) else 0.0
        if psi_val > 0.2:
            verdict = "MAJOR SHIFT"
            major_shift_count += 1
        elif psi_val > 0.1:
            verdict = "SLIGHT SHIFT"
        else:
            verdict = "NO SHIFT"
        rows.append([col_name[:25], f"{psi_val:.4f}", f"{ks_stat:.4f}", f"{p_val:.2e}", f"{corr_val:+.4f}", verdict])
    print("\nCRITIC GENERALIZATION & FEATURE SHIFT DIAGNOSTIC:")
    print_table(["Feature", "PSI", "KS Stat", "KS p-val", "Critic Corr", "Verdict"], rows)

