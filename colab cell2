            best_null_pnls.append(best_null_pnl)

        slice_len_period = len(tp_val_1) if "Slice" in period_key else len(tp_val_holdout)
        overlap_factor_period = max(1.0, (val_holdout_ep_len * len(EVAL_SEEDS)) / (slice_len_period + 1e-9))

        diffs = np.array(agent_pnls_slice) - np.array(best_null_pnls)
        n_eff = max(3.0, len(diffs) / overlap_factor_period)
        mean_diff = np.mean(diffs)
        var_diff = np.var(diffs, ddof=1) if len(diffs) > 1 else 0.0
        se = math.sqrt(var_diff / n_eff + 1e-12)
        t_stat_slice = mean_diff / se
        df_val = max(3.0, n_eff - 1)
        log_p = stats.t.logsf(abs(t_stat_slice), df=df_val) + math.log(2.0)
        neg_log10_p = -log_p / math.log(10.0)
        z_slice = float(stats.norm.isf(np.exp(log_p))) if log_p > -50.0 else 10.0
        if t_stat_slice < 0:
            z_slice = -z_slice

        prob_out, m_diff, s_diff = paired_bootstrap_analysis(agent_pnls_slice, best_null_pnls)
        prob_str = f"{prob_out:.1%}"

        if math.isnan(t_stat_slice):
            t_str = "N/A"
            p_str = "N/A"
            z_str = "N/A"
        else:
            t_str = f"{t_stat_slice:>+10.3f}"
            p_str = f"{neg_log10_p:.4f}"
            z_str = f"{z_slice:>+10.2f}"
            if "Slice" in period_key:
                slice_z_scores.append(z_slice)

        opt_l_mean = np.mean([optimal_lambdas[sd] for sd in SEED_SET])
        avg_branch_switches = np.mean(branch_switches_list)

        wfa_rows.append([
            period_key,
            f"{np.mean(agent_pnls_slice):>+9.2f} ± {safe_std(agent_pnls_slice):.2f}",
            f"{np.mean(best_null_pnls):>+10.2f}",
            prob_str,
            t_str,
            p_str,
            f"{z_slice:>+8.2f}",
            f"{opt_l_mean:.3f}",
            f"{avg_branch_switches:.1f}"
        ])

    print("\nWALK-FORWARD ANALYSIS (WFA) & OUT-OF-SAMPLE BENCHMARKING:")
    print_table(["Val Period", "Agent PnL Mean±Std", "Best Null PnL", "P(Ag>Null)", "t-stat", "-log10(p)", "Eff z", "Opt Lambda", "Branch Switches"], wfa_rows)

    execution_timing_ledger.append(["WFA & OOS Benchmarking", f"{time.perf_counter() - wfa_start:.4f}"])

    agent_runs = []
    for idx, sd in enumerate(SEED_SET):
        esd = EVAL_SEEDS[idx]
        opt_l = optimal_lambdas[sd]
        res_list = ablation_raw_results[opt_l]
        matching_res = next((r for r in res_list if r["seed"] == sd), None)
        eval_env_local = BootstrapFix(SubEpisodeEnv(TargetWeightEnv(get_fresh_sim(sim), symbols, WINDOW, tp_val_holdout, turnover_penalty_lambda=opt_l, is_eval=True, decision_interval=16), ep_len=val_holdout_ep_len))
        ag_local = make_agent(eval_env_local, sd, n_steps=n_steps, batch_size=batch_size)
        ag_local.policy.load_state_dict(matching_res["policy_state_dict"])
        run_res = rollout(env_val_holdout, lambda o, e, a=ag_local: a.predict(o, deterministic=True)[0], esd)
        agent_runs.append(run_res)

    agg_ag, row_trained = summarize("agent:trained", agent_runs)

    print("\nTRAINED AGENT EVALUATION SUMMARY:")
    print_table(["Policy", "Eq", "Sortino", "Skew", "Kurt", "CVaR95", "PF", "WR%"], [row_trained, row_untrained])

    run_distribution_shift_diagnostic(agents[SEED_SET[0]])

    all_oos_returns = []
    for r in agent_runs:
        eqs_run = r["_eqs"]
        rets_run = np.diff(eqs_run) / (np.abs(eqs_run[:-1]) + 1e-12)
        all_oos_returns.append(rets_run)

    srs_oos = []
    for r in all_oos_returns:
        std = np.std(r, ddof=1)
        srs_oos.append(np.mean(r) / std if std > 1e-9 else 0.0)
    best_seed_idx = np.argmax(srs_oos)
    best_seed = SEED_SET[best_seed_idx]

    pbo_val = compute_cscv_pbo(all_oos_returns)
    dsr_prob, best_sr, sr_star = compute_dsr(all_oos_returns, best_seed_idx)

    print("\nBACKTEST OVERFITTING & SELECTION BIAS DIAGNOSTIC:")
    pbo_str = "N/A (Loss Set)" if max(srs_oos) <= 0.0 else f"{pbo_val:.1%}"
    dsr_verdict = "PASS" if dsr_prob >= 0.95 else "FAIL"
    quant_rows = [
        ["PBO via CPCV", pbo_str],
        ["Best Trial SR (unann)", f"{best_sr:.4f}"],
        ["Exp Max SR Null (N=24)", f"{sr_star:.4f}"],
        ["Deflated Sharpe Prob (DSR)", f"{dsr_prob:.2%}"],
        ["Selection Bias Verdict", dsr_verdict]
    ]
    print_table(["Metric", "Value"], quant_rows)

    print("\nTURNOVER PENALTY ABLATION STUDY:")
    ablation_summary_rows = []
    for l_val in LAMBDA_CONFIGS:
        l_env = BootstrapFix(SubEpisodeEnv(TargetWeightEnv(get_fresh_sim(sim), symbols, WINDOW, tp_val_holdout, turnover_penalty_lambda=l_val, is_eval=True, decision_interval=16), ep_len=val_holdout_ep_len))
        mags = []
        sortinos = []
        eqs_oos = []
        for idx, sd in enumerate(SEED_SET):
            esd = EVAL_SEEDS[idx]
            res_list = ablation_raw_results[l_val]
            matching_res = next((r for r in res_list if r["seed"] == sd), None)
            if matching_res is not None:
                eval_env_local = BootstrapFix(SubEpisodeEnv(TargetWeightEnv(get_fresh_sim(sim), symbols, WINDOW, tp_val_holdout, turnover_penalty_lambda=l_val, is_eval=True, decision_interval=16), ep_len=val_holdout_ep_len))
                ag_local = make_agent(eval_env_local, sd, n_steps=n_steps, batch_size=batch_size)
                ag_local.policy.load_state_dict(matching_res["policy_state_dict"])
                eval_res = rollout(eval_env_local, lambda o, e, a=ag_local: a.predict(o, deterministic=True)[0], esd)
                mags.append(np.mean(np.abs(eval_res["actions_history"])))
                sortinos.append(eval_res["sortino"])
                eqs_oos.append(eval_res["final_eq"])

        m_mag = np.mean(mags) if mags else 0.0
        m_sort = np.mean(sortinos) if sortinos else 0.0
        m_eq = np.mean(eqs_oos) if eqs_oos else 10000.0
        ablation_summary_rows.append([f"{l_val:.2f}", f"{m_mag:.4f}", f"{m_sort:.2f}", f"{m_eq:.2f}"])
    print_table(["Penalty Lambda", "Mean Mag", "OOS Sortino", "OOS Equity"], ablation_summary_rows)

    reward_decomposition_diagnostic(env_val_holdout, agents[SEED_SET[0]], SEED_SET[0])
    action_saturation_diagnostic(env_val_holdout, agents[SEED_SET[0]], SEED_SET[0])

    stress_start = time.perf_counter()
    cost_multipliers = [1.0, 1.5, 2.0]
    overlap_factor_full = max(1.0, (val_holdout_ep_len * len(EVAL_SEEDS)) / (len(tp_val_holdout) + 1e-9))

    stress_rows = []
    eq_diffs = []
    for cm in cost_multipliers:
        if cm == 1.0:
            agent_cost_runs = agent_runs
            bm_cost_runs = NULL_EVAL_CACHE["Full Holdout"]["trend_results"]
            vol_cost_runs = NULL_EVAL_CACHE["Full Holdout"]["vol_results"]
            agg_ac = agg_ag
        else:
            agent_cost_runs = []
            for idx, sd in enumerate(SEED_SET):
                esd = EVAL_SEEDS[idx]
                opt_l = optimal_lambdas[sd]
                env_val_cost = BootstrapFix(SubEpisodeEnv(TargetWeightEnv(get_fresh_sim(sim), symbols, WINDOW, tp_val_holdout, cost_multiplier=cm, turnover_penalty_lambda=opt_l, is_eval=True, decision_interval=16), ep_len=val_holdout_ep_len))
                res_list = ablation_raw_results[opt_l]
                matching_res = next((r for r in res_list if r["seed"] == sd), None)
                ag_local = make_agent(env_val_cost, sd, n_steps=n_steps, batch_size=batch_size)
                ag_local.policy.load_state_dict(matching_res["policy_state_dict"])
                run_res = rollout(env_val_cost, lambda o, e, a=ag_local: a.predict(o, deterministic=True)[0], esd)
                agent_cost_runs.append(run_res)

            bm_cost_runs = []
            vol_cost_runs = []
            for idx, sd in enumerate(SEED_SET):
                esd = EVAL_SEEDS[idx]
                opt_l = optimal_lambdas[sd]
                env_val_cost = BootstrapFix(SubEpisodeEnv(TargetWeightEnv(get_fresh_sim(sim), symbols, WINDOW, tp_val_holdout, cost_multiplier=cm, turnover_penalty_lambda=opt_l, is_eval=True, decision_interval=16), ep_len=val_holdout_ep_len))
                bm_res = rollout(env_val_cost, lambda o, e: full_benchmark_policy(e), esd)
                vol_res = rollout(env_val_cost, lambda o, e: vol_target_policy(e), esd)
                bm_cost_runs.append(bm_res)
                vol_cost_runs.append(vol_res)

        for idx, sd in enumerate(SEED_SET):
            run_res = agent_cost_runs[idx]
            r_net = run_res["final_eq"] - 10000.0
            r_rec = run_res["reconciled_pnl"]
            r_res = run_res["residual"]
            r_gross_rel = run_res["gross_raw_realized"]
            r_gross_unrel = run_res["gross_raw_unrealized"]
            r_swaps = run_res.get("accumulated_swaps", 0.0)
            r_fees = run_res.get("accumulated_fees", 0.0)
            stress_rows.append([f"{cm:.1f}", str(sd), f"{r_net:>+10.2f}", f"{r_rec:>+10.2f}", f"{r_res:>+9.2e}", f"{r_gross_rel:>+14.2f}", f"{r_gross_unrel:>+16.2f}", f"{r_swaps:>+9.2f}", f"{r_fees:>+8.2f}"])

        agent_cost_eqs = [r["final_eq"] for r in agent_cost_runs]
        bm_cost_eqs = [r["final_eq"] for r in bm_cost_runs]
        vol_cost_eqs = [r["final_eq"] for r in vol_cost_runs]

        best_null_cost_eqs = bm_cost_eqs if np.mean(bm_cost_eqs) > np.mean(vol_cost_eqs) else vol_cost_eqs
        t_stat_cost, neg_log10_p_cost, z_cost = corrected_welch_ttest(agent_cost_eqs, best_null_cost_eqs, overlap_factor_full)

        if cm > 1.0:
            pct_diff = abs(np.mean(agent_cost_eqs) - np.mean([r["final_eq"] for r in agent_runs])) / 10000.0 * 100.0
            eq_diffs.append(pct_diff)

    print("\nCOST SENSITIVITY STRESS TEST & PNL RECONCILIATION AUDIT:")
    print_table(["Cost Mult", "Seed", "Net PnL", "Reconciled", "Residual", "Gross Realized", "Gross Unrealized", "Swaps", "Fees"], stress_rows)

    execution_timing_ledger.append(["Cost Sensitivity Stress Test", f"{time.perf_counter() - stress_start:.4f}"])

    decomp_start = time.perf_counter()
    symbol_breakdown = defaultdict(list)
    for r in agent_runs:
        for s_sym, pnl_val in r.get("symbol_closed_pnl", {}).items():
            symbol_breakdown[s_sym].append(pnl_val)

    decomp_rows = []
    for s_sym in symbols:
        p_vals = symbol_breakdown.get(s_sym, [0.0])
        decomp_rows.append([s_sym, f"{np.mean(p_vals):+9.2f}", f"{safe_std(p_vals):.2f}"])

    print("\nPER-SYMBOL CLOSED PNL DECOMPOSITION:")
    print_table(["Symbol", "Closed PnL Mean", "Std"], decomp_rows)

    execution_timing_ledger.append(["Per-Symbol PnL Decomposition", f"{time.perf_counter() - decomp_start:.4f}"])

    power_start = time.perf_counter()
    agent_full_pnls = [r["final_eq"] - 10000.0 for r in agent_runs]
    cached_oos_full = NULL_EVAL_CACHE.get("Full Holdout", {})
    best_null_full_pnls = cached_oos_full.get("best_null_pnls")

    req_seeds, calculated_d = compute_required_seeds(agent_full_pnls, best_null_full_pnls, alpha=0.05, power=0.80)
    power_rows = [
        ["Observed Cohen's d", f"{calculated_d:.4f}"],
        ["Required Seeds (80% power)", str(req_seeds)]
    ]
    print("\nSTATISTICAL POWER ANALYSIS:")
    print_table(["Metric", "Value"], power_rows)

    execution_timing_ledger.append(["Statistical Power Analysis", f"{time.perf_counter() - power_start:.4f}"])

    n_trials = len(SEED_SET) * len(LAMBDA_CONFIGS)
    z_req = 2.0 + math.sqrt(2 * math.log(max(n_trials, 1)))
    is_degenerate = (agg_ag["trades_per_1k"][0] < 1.0) or (agg_ag["pct_in_market"][0] < 10.0)

    if is_degenerate:
        verdict = "BAD (degenerate)"
        z_vs_best_null_eq = 0.0
        margin_vs_carry_eq = 0.0
    else:
        a_eq_samples = [r["final_eq"] for r in agent_runs]
        a_pnl_samples = [eq - 10000.0 for eq in a_eq_samples]

        null_runs_paired = []
        for esd in EVAL_SEEDS:
            bm_res = rollout(env_val_holdout, lambda o, e: full_benchmark_policy(e), esd)
            vol_res = rollout(env_val_holdout, lambda o, e: vol_target_policy(e), esd)
            best_null_pnl = max(bm_res["final_eq"] - 10000.0, vol_res["final_eq"] - 10000.0)
            null_runs_paired.append(best_null_pnl)

        diffs = np.array(a_pnl_samples) - np.array(null_runs_paired)
        n_eff = max(3.0, len(diffs) / overlap_factor_full)
        mean_diff = np.mean(diffs)
        var_diff = np.var(diffs, ddof=1) if len(diffs) > 1 else 0.0
        se = math.sqrt(var_diff / n_eff + 1e-12)
        t_stat_eq = mean_diff / se
        df_val = max(3.0, n_eff - 1)
        log_p = stats.t.logsf(abs(t_stat_eq), df=df_val) + math.log(2.0)
        neg_log10_p_eq = -log_p / math.log(10.0)
        z_vs_best_null_eq = float(stats.norm.isf(np.exp(log_p))) if log_p > -50.0 else 10.0
        if t_stat_eq < 0:
            z_vs_best_null_eq = -z_vs_best_null_eq

        margin_vs_carry_eq = float(np.mean(a_pnl_samples) / (safe_std(a_pnl_samples) + 1e-12))

        passed_eq = (z_vs_best_null_eq >= z_req and margin_vs_carry_eq > 2.0)

        slices_positive = len(slice_z_scores) > 0 and all(z >= 0.0 for z in slice_z_scores)
        slices_statistically_strong = len(slice_z_scores) > 0 and all(z >= 1.96 for z in slice_z_scores)

        if z_vs_best_null_eq < 0.0 or any(z < 0.0 for z in slice_z_scores):
            verdict = "BAD"
        elif passed_eq and slices_statistically_strong:
            verdict = "CONFIRMED"
        elif z_vs_best_null_eq >= 2.0 and slices_positive:
            verdict = "LIKELY"
        elif z_vs_best_null_eq > 0.0:
            verdict = "CONDITIONAL"
        else:
            verdict = "BAD"

    print("\nFINAL SYSTEM EVALUATION VERDICT:")
    verdict_rows = [
        ["Paired t-stat (Equity)", f"{t_stat_eq:.3f}" if not math.isnan(t_stat_eq) else "N/A"],
        ["Effective z-score", f"{z_vs_best_null_eq:.2f}"],
        ["Margin vs Carry Ratio", f"{margin_vs_carry_eq:.2f}"],
        ["Required Deflated z-score", f"{z_req:.2f}"],
        ["FINAL SYSTEM VERDICT", verdict]
    ]
    print_table(["Evaluation Metric", "Result / Status"], verdict_rows)

    execution_timing_ledger.append(["Total Execution Time", f"{time.perf_counter() - global_start_time:.4f}"])

    print("\nCONSOLIDATED EXECUTION TIMING LEDGER:")
    print_table(["Diagnostic Module / Stage", "Execution Time (s)"], execution_timing_ledger)
